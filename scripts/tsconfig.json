{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["*.ts", "scrapers/*.ts", "pipeline/*.ts", "utils/*.ts"],
  "exclude": ["node_modules"]
}
