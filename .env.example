# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://flm-auto.fr

# ── ALAIN (AI Assistant) ──
# Option A : Local Ollama (gratuit, recommandé pour dev)
OLLAMA_URL=http://localhost:11434
ALAIN_MODEL=alain-auto-base
# Option B : Cloud fallback (Anthropic, payant)
ANTHROPIC_API_KEY=sk-ant-...

# ── Newsletter (optionnel, requis pour envoyer des emails) ──
RESEND_API_KEY=re_...

# ── Data Scraping (optionnel, requis pour les scripts d'import) ──
YOUTUBE_API_KEY=AIza...
UNSPLASH_ACCESS_KEY=xxx

# ── Google Search Console (optionnel) ──
NEXT_PUBLIC_GSC_VERIFICATION=xxx

# ── Analytics (auto-configuré par Vercel) ──
# VERCEL_ANALYTICS_ID=xxx
